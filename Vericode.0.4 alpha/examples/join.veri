// Joining tables on a shared column (0.6).
// Run with: veri -run examples/join.veri

let people = table([
    {"id": 1, "name": "Ada"},
    {"id": 2, "name": "Bob"},
    {"id": 3, "name": "Cy"}
], ["id", "name"]);

let scores = table([
    {"id": 1, "score": 90},
    {"id": 3, "score": 70},
    {"id": 3, "score": 75}
], ["id", "score"]);

// Inner join: only ids present on both sides, one row per match.
print tjoin(people, scores, "id");

// Left join: unmatched people stay, with null score columns.
print tjoin(people, scores, "id", "left");
