// VeriCode 0.4 — data-oriented programming
// Run with: veri -run examples/data.veri

// ─── 1. Pipelines ───────────────────────────────────────────────────────────
// |> feeds the value on its left into the FIRST argument of the next call.
let nums = range(1, 21);

let total = nums
    |> filter(func(x) { return x % 2 == 0; })
    |> map(func(x) { return x * x; })
    |> take(4)
    |> sum;
print "sum of squares: " + str(total);

// ─── 2. Batch transforms ────────────────────────────────────────────────────
print chunk(range(0, 7), 3);
print zip(["a", "b", "c"], [1, 2]);
print uniq([1, 2, 1, 3]);
print sort_by(["ccc", "a", "bb"], func(s) { return len(s); });

let groups = group_by(range(0, 6), func(x) { return x % 2; });
print groups[0];
print groups[1];

// ─── 3. Tables ──────────────────────────────────────────────────────────────
// Rows are hashes; headers give the column order. t[0] is a row,
// t["age"] is the whole column.
let people = table([
    {"name": "Ada", "age": 36, "city": "London"},
    {"name": "Bob", "age": 5,  "city": "Paris"},
    {"name": "Cy",  "age": 41, "city": "London"}
], ["name", "age", "city"]);

print people;
print people["city"];

let report = people
    |> twhere(func(row) { return row["age"] >= 18; })
    |> tsort("age", "desc")
    |> tselect("name", "age");
print report;

// ─── 4. CSV ─────────────────────────────────────────────────────────────────
// CSV has no types, so values arrive as strings.
let text = "name,score\nAda,95\nBob,88\n";
let scores = csv_table(text);
print scores;
print "total score: " + str(scores["score"] |> map(int) |> sum);
print csv_write(scores);

// ─── 5. JSON ────────────────────────────────────────────────────────────────
let config = json_parse("{\"debug\": true, \"retries\": 3}");
print config["retries"] + 1;
print json_write(config, 2);

// ─── 6. Files (CLI only) ────────────────────────────────────────────────────
